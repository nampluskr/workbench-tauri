// JSONC sample: JSON with comments.
{
  /* block comment */
  "compilerOptions": {
    "target": "ES2022",
    "strict": true, // line comment
    "lib": ["dom", "es2022"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist", // trailing comma allowed
  ],
  "ratio": 1.5,
  "nothing": null
}
