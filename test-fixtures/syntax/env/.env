# Env sample. Plain example values only.
APP_NAME="Workbench Sample"
APP_PORT=8080
APP_DEBUG=true
export APP_MODE=development

# Paths
DATA_DIR=./data
LOG_FILE="${DATA_DIR}/app.log"

# Quoted values
GREETING='Hello, world'
EMPTY=
RATIO=0.75

# Numbers and flags
MAX_ITEMS=40
FEATURE_FLAGS=search,preview
